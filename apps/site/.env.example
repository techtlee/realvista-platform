NEXT_PUBLIC_CMS_URL=http://localhost:3000
# Tenant this site belongs to, and a read-only API key scoped to it.
# Mint with: cd ../../../cms && TENANT_SLUG=<slug> pnpm seed:site-key
TENANT_ID=
CMS_API_KEY=

# Set to 1 to show the floating colour-variant switcher. Preview and storefront
# demos only — a real client site must leave this unset.
NEXT_PUBLIC_VARIANT_PREVIEW=

# Shared with the tenant's revalidateSecret in the CMS. The CMS calls
# /api/revalidate with this header whenever content changes.
REVALIDATE_SECRET=
